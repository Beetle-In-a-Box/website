// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Issue {
  id          String    @id @default(cuid())
  title       String
  number      Int       @unique
  // Date of issue publication (formatted as "MONTH YEAR" in UI)
  date        DateTime
  // Image URL or path - can store uploaded image paths
  imageUrl    String?
  // Artist name for cover image attribution
  imageArtist String?
  // PDF URL or path - optional PDF download for the entire issue
  pdfUrl      String?
  published   Boolean   @default(false)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([number])
  @@index([published])
  @@index([date])
}

model Author {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique  // e.g., "john-smith-abc123"
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Article {
  id              String   @id @default(cuid())
  title           String
  shortTitle      String?
  number          Int
  // Artist name for image attribution
  imageArtist     String?
  // Cover image URL or path
  imageUrl        String?
  // Path to the .docx file containing article content and footnotes/endnotes
  contentDocxPath String
  // Preview text for issue page (can be manually entered or auto-extracted from .docx)
  previewText     String   @db.Text
  // Generated filename for URL-friendly access
  fileName        String
  published       Boolean  @default(false)

  // Relation to Issue
  issueId         String
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  // Relation to Author
  authorId        String?
  author          Author?  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([issueId, number])
  @@index([issueId])
  @@index([authorId])
  @@index([published])
  @@index([fileName])
}
