{
    "name": "beetle-in-a-box",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build --turbopack",
        "start": "next start",
        "lint": "eslint",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "db:clear": "bun scripts/clear-database.ts",
        "db:seed": "bun scripts/seed-issue-1.ts",
        "db:reset": "bun run db:clear && bun run db:seed",
        "build:prod": "bunx next build",
        "serve": "bun run build:prod && node server.js",
        "deploy": "bash ../deploy.sh",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "@types/jsdom": "^27.0.0",
        "bcryptjs": "^3.0.3",
        "html-react-parser": "^5.2.17",
        "html-to-docx": "^1.8.0",
        "jose": "^6.1.3",
        "jsdom": "^27.4.0",
        "mammoth": "^1.11.0",
        "next": "^15.5.12",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-toastify": "^11.0.5",
        "sass": "^1.97.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/bcryptjs": "^3.0.0",
        "@types/html-to-docx": "^1.8.0",
        "@types/node": "^20.19.33",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.2",
        "eslint-config-next": "15.5.9",
        "happy-dom": "^20.6.1",
        "prisma": "^6.19.2",
        "typescript": "^5.9.3"
    },
    "optionalDependencies": {
        "sharp": "^0.35.3"
    }
}
